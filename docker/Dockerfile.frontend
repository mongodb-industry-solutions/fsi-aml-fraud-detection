FROM node:20.18.0-alpine

# Accept build arguments for Next.js public env vars
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AML_API_URL

# Set as environment variables for the build
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_AML_API_URL=$NEXT_PUBLIC_AML_API_URL

# Browser-facing URL of the standalone BIAN Data Model Explorer. Baked at build
# time because pages are statically prerendered — a runtime env var would not
# reach the prerendered HTML. Per-environment value comes from the kaniko
# build_args in .drone.yml; defaults to the deployed staging explorer so local
# builds link somewhere live without running bian-model locally.
ARG BIAN_MODEL_URL=https://leafy-bank-bian-model.industrysolutions.staging.corp.mongodb.com
ENV BIAN_MODEL_URL=$BIAN_MODEL_URL

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ .

# Build Next.js app with the env vars baked in
RUN npm run build

# Expose Next.js port (8080) and WebSocket proxy port (8081)
EXPOSE 3000 8081

CMD ["npm", "start"]
